# =============================================================================
# chatbot-app/frontend/.env.local template — the two-app console
# =============================================================================
#
# One Next.js process serves both applications behind the app rail: Trade Reconciliation
# (/recon, BFF /api/recon) and Deal Pipeline (/pipeline, BFF /api/pipeline). Copy this file to
# .env.local, which `next dev` loads into the server process and which is gitignored. In the
# deployed container the same names arrive from the ECS task definition
# (infra/modules/frontend-ecs), never from this file.
#
# Access model: each app has an ACCESS group ("may use it") and an ADMIN group ("may change its
# configuration and approve"); admins implicitly have access. An app whose access group is UNSET
# is open to every authenticated user unless REQUIRE_ACCESS_GROUPS=true (below). Group names are
# identity-provider group claims (AUTH_GROUPS_CLAIM), so nothing here creates a group — an operator
# maintains membership in the provider. The registry that reads these names is src/lib/auth/apps.ts.

# --- Authorization -----------------------------------------------------------------------------
# Local-dev escape hatch: "true" (exact match) skips token verification and grants EVERY app and
# both admin roles to the single "anonymous" subject. Never set in a deployment. The BFF honours
# three names for this one switch: ALLOW_ANONYMOUS_API (this file), plus the pre-shell
# RECON_ALLOW_ANONYMOUS_API and PIPELINE_ALLOW_ANONYMOUS_API, so an older .env.local keeps working.
# Any ONE of them being "true" opens BOTH BFFs — there is one server process — so a deployment
# audit has to check all three names, and none of them may be set there.
ALLOW_ANONYMOUS_API=true
# Preview a restricted user under anonymous mode: comma-separated group names the anonymous
# subject carries INSTEAD of every configured group. Leave unset to see the console as an admin
# of both apps.
# ANONYMOUS_GROUPS=deal-desk
# Deployment switches the composed Terraform sets on the ECS task; leave unset locally.
# PIPELINE_ENABLED=false        -> exactly "false" hides the Deal Pipeline and 403s its API
# REQUIRE_ACCESS_GROUPS=true    -> exactly "true" makes an UNSET access group admins-only instead of open
# Trade Reconciliation — who may use the app. Unset = every authenticated user.
RECON_ACCESS_GROUP=
# Trade Reconciliation — who may change configuration (thresholds, backend, Tier-1, contacts,
# templates, workflow types), delete memory records and upload documents. Unset = nobody. NOTE: the
# system prompt, skills, harness configs, eval batches and bulk case updates are gated by ACCESS only,
# so RECON_ACCESS_GROUP is the boundary that decides who may rewrite the recon agent's behaviour.
RECON_ADMIN_GROUP=recon-admins
# Deal Pipeline — who may use the app. Unset = every authenticated user.
PIPELINE_ACCESS_GROUP=
# Deal Pipeline — who may approve/reject deals, edit fields, write skills and memories. Unset = nobody.
PIPELINE_ADMIN_GROUP=deal-desk-admins
# Fail closed on a blank access group: "true" (exact match) denies an app whose *_ACCESS_GROUP is
# unset to everyone but its admins, instead of opening it to every authenticated user. The composed
# ECS deployment sets this whenever the pipeline is enabled (two apps behind one sign-in must each
# name who may enter). Unset here so a recon-only laptop run stays open, as before the shell.
# REQUIRE_ACCESS_GROUPS=true
# Switch the Deal Pipeline app off in a running console: "false" (exact match) makes /api/me hide it
# and the proxy answer 403 on /api/pipeline/*. Unset or anything else = enabled, so local dev needs
# nothing here; the ECS task definition sets it from the pipeline_enabled Terraform input.
# PIPELINE_ENABLED=false
# Browser-side login flow: "okta" or "entra". Build-time in the container (NEXT_PUBLIC_*).
NEXT_PUBLIC_AUTH_PROVIDER=entra
# Region every BFF client is built for.
AWS_REGION=us-east-1

# Server-side token verification, read only when none of the three anonymous switches above is
# "true". An incomplete set is a 503 from the BFF, never an open door.
# AUTH_PROVIDER=okta                  # or entra; the runtime copy of NEXT_PUBLIC_AUTH_PROVIDER
# OKTA_ISSUER=                        # https://<org>.okta.com/oauth2/default
# OKTA_CLIENT_ID=
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# AUTH_GROUPS_CLAIM=groups            # Okta: groups. Entra: groups or roles, per the app manifest.
# Browser-side login settings for the provider named above (inlined into the bundle at build).
# NEXT_PUBLIC_OKTA_ISSUER=
# NEXT_PUBLIC_OKTA_CLIENT_ID=
# NEXT_PUBLIC_OKTA_REDIRECT_URI=      # https://<frontend-domain>/login/callback
# NEXT_PUBLIC_ENTRA_TENANT_ID=
# NEXT_PUBLIC_ENTRA_CLIENT_ID=
# NEXT_PUBLIC_ENTRA_API_AUDIENCE=

# --- Trade Reconciliation (/api/recon) ---------------------------------------------------------
# Every name below mirrors the ECS task environment in infra/modules/frontend-ecs/main.tf. The recon
# root (infra/environments/recon) has no per-variable outputs — its values reach the console only
# through the task definition — so for a laptop run against a deployed environment copy them from
# that task definition (`aws ecs describe-task-definition`), not from `terraform output`.
# Case lifecycle table (status GSI) and the append-only status-transition log.
CASES_TABLE=recon-dev-cases
AUDIT_TABLE=recon-dev-audit
# Recon's own S3 bucket: skills, system prompts, upload staging, harness config, KB corpus.
ASSETS_BUCKET=
# Catalog key, editable skills prefix and the two system prompts inside ASSETS_BUCKET.
SKILLS_CATALOG_KEY=skills-catalog.json
SKILLS_PREFIX=skills/
SYSTEM_PROMPT_KEY=system-prompt.md
HARNESS_SYSTEM_PROMPT_KEY=system-prompt-harness.md
# Lessons-learned ledger (analyst decisions fed back to the agent).
LESSONS_TABLE=recon-dev-lessons
# Shared mailbox all Graph email is sent from; empty disables the email step.
GRAPH_MAILBOX=
# Recipient contacts, email templates and extraction workflow types (Config tab write targets).
CONTACTS_TABLE=recon-dev-contacts
TEMPLATES_TABLE=recon-dev-email-templates
WORKFLOW_TYPES_TABLE=recon-dev-workflow-types
# Upload route: audit table, the document pipeline's input bucket, recon's staging bucket and the
# email-preprocess Lambda. Read with no fallback — a missing name fails the request, by design.
UPLOADS_TABLE=recon-dev-uploads
IDP_INPUT_BUCKET=
UPLOAD_STAGING_BUCKET=
EMAIL_PREPROCESS_FUNCTION=recon-dev-email-preprocess
# Documents tab: the document pipeline's AppSync endpoint (server-side only) and recon's notice rows.
IDP_APPSYNC_ENDPOINT=
NOTICES_TABLE=recon-dev-notices
# Egress tools gateway (SigV4) the BFF calls for sends and searches; the re-process cap per case.
RECON_GATEWAY_URL=
REPROCESS_CAP=3
# Tier-2 agent: runtime ARN, the agent-worker Lambda (reject -> reprocess) and the intake Lambda.
AGENT_RUNTIME_ARN=
AGENT_WORKER_FUNCTION=
INTAKE_FUNCTION=recon-dev-intake
# Config tab -> Policy: the Cedar policy engine and the gateway it is attached to.
POLICY_ENGINE_NAME=
EGRESS_GATEWAY_ARN=
# Config tab: Tier-1 toggle parameter and the read-only Lambda source prefix it shows.
TIER1_ENABLED_PARAM=/recon-dev/tier1-enabled
LAMBDA_SRC_PREFIX=lambda-src/tier1/
# Lessons -> AgentCore Memory feed.
RECON_MEMORY_ID=
# Config tab parameters: auto-resolve threshold, decision-comment requirement, backend selector,
# live Tier-2 model selection.
AUTO_RESOLVE_PARAM=/recon-dev/auto-resolve-threshold
COMMENT_REQUIREMENT_PARAM=/recon-dev/comment-requirement
AGENT_BACKEND_PARAM=/recon-dev/agent-backend
AGENT_MODEL_PARAM=/recon-dev/agent-model-id
# Evals tab: name prefix, harness config-version pointer, log groups, evaluator id.
NAME_PREFIX=recon-dev
HARNESS_CONFIG_VERSION_PARAM=/recon-dev/harness-config-version
EVAL_RESULTS_LOG_GROUP_PREFIX=
HARNESS_LOG_GROUP=
HARNESS_SERVICE_NAME=
ANALYST_AGREEMENT_EVALUATOR_ID=
# Human-confirmation token the gateway interceptor requires on the approve/notify email send.
EMAIL_CONFIRMATION_TOKEN=
# Account id for the recommendations route (CloudWatch Logs ARN construction).
AWS_ACCOUNT_ID=
# JSON maps keyed by backend id (harness/runtime): OTel service names and event log groups.
BACKEND_SERVICE_NAMES={}
BACKEND_EVENT_LOG_GROUPS={}

# --- Deal Pipeline (/api/pipeline) -------------------------------------------------------------
# Local development runs against the standalone root, infra/environments/deal-pipeline:
# `terraform output -raw env_local` there renders this whole block. The composed recon root
# (enable_deal_pipeline = true) exposes no pipeline outputs — it delivers these names only through
# the ECS task definition — so it is the deployed shape, not a source for this file. The three
# PIPELINE_-prefixed names exist because the bare names above belong to the recon app when both run
# in one process; the pipeline BFF reads ONLY the prefixed names (no fallback to ASSETS_BUCKET,
# AGENT_MODEL_PARAM or SKILLS_PREFIX). PIPELINE_ASSETS_BUCKET and PIPELINE_AGENT_MODEL_PARAM are
# required; PIPELINE_SKILLS_PREFIX defaults to skills/.
# The pipeline's S3 bucket: skills, prompts, security master, raw emails, staging CSVs, samples.
PIPELINE_ASSETS_BUCKET=
# Emails, deals and skill-proposal tables.
EMAILS_TABLE=deal-pipeline-dev-emails
DEALS_TABLE=deal-pipeline-dev-deals
SKILL_PROPOSALS_TABLE=deal-pipeline-dev-skill-proposals
# AgentCore Memories: edge-case rules the parser recalls, and chat history. Empty = feature off.
KNOWLEDGE_MEMORY_ID=
CHAT_MEMORY_ID=
# Parsing-agent Lambda (async on intake/reparse) and the mock OMS validator (sync on approve).
PARSER_FUNCTION=deal-pipeline-dev-parser
OMS_UPLOAD_FUNCTION=deal-pipeline-dev-oms-upload
# SSM parameter the Config tab writes and the parser reads per invocation.
PIPELINE_AGENT_MODEL_PARAM=/deal-pipeline-dev/agent-model-id
# Model the assistant (chat) route invokes; no Config-tab override.
ASSISTANT_MODEL_ID=us.anthropic.claude-sonnet-5
# Sample corpus on disk, relative to chatbot-app/frontend. When the directory does not exist (the
# container), samples are read from PIPELINE_ASSETS_BUCKET under PIPELINE_SAMPLES_PREFIX instead.
SAMPLE_EMAILS_DIR=../../data/deal-emails
PIPELINE_SAMPLES_PREFIX=samples/
# Skills prefix and parser system-prompt key inside PIPELINE_ASSETS_BUCKET.
PIPELINE_SKILLS_PREFIX=skills/
PARSER_PROMPT_KEY=prompts/parser-system.md
