# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# MAINTENANCE: this example is the only committed record of which variables an
# environment is expected to set — keep it in sync. Whenever you add a variable
# to variables.tf or set a new value in your local terraform.tfvars, add a
# placeholder entry (never a real credential) here in the same change.
region                 = "us-east-1"
name_prefix            = "recon-dev"
hosted_ui_prefix       = "recon-dev-login-CHANGEME" # must be globally unique
idp_gateway_target_url = ""                         # set to the deployed IDP endpoint to enable the IDP tool
# recon_domain         = "cash"                     # domain the IDP hook stamps on ingested items
# The console's Documents tab. Both come from the document pipeline's own stack outputs; leave them
# empty and the tab renders a "not configured" message instead of a list. Neither is a secret -- the
# endpoint is unauthenticated to reach and refuses every unsigned request.
idp_appsync_endpoint = "" # GraphQLAPIURL output, e.g. https://EXAMPLE.appsync-api.us-east-1.amazonaws.com/graphql
idp_appsync_api_arn  = "" # arn:aws:appsync:us-east-1:ACCOUNT_ID:apis/API_ID
# Where an extraction-routed upload is put. Empty leaves the upload route reporting it has nowhere to
# put an extraction file, which is what you want: a put into a guessed bucket is read by nothing and
# still records UPLOADED.
idp_input_bucket     = "" # the document pipeline's input bucket, e.g. idp-unified-input-ACCOUNT_ID
idp_input_bucket_arn = "" # arn:aws:s3:::idp-unified-input-ACCOUNT_ID

# ⚠️ The one that decides whether an uploaded document ever becomes a notice. Recon puts an
# EventBridge rule on this state machine's SUCCEEDED events and that rule is the ONLY thing that
# invokes the ingest hook. Leave it empty and uploads still succeed, extraction still completes, and
# the notices table stays permanently empty with nothing reporting a fault -- so set it whenever
# idp_input_bucket is set. The suffix is regenerated on every pipeline rebuild; re-read it then.
idp_state_machine_arn = "" # arn:aws:states:us-east-1:ACCOUNT_ID:stateMachine:PIPELINE-document-processing

# The extraction workflow type the upload dialog opens with. Empty (the default) skips the seed, so
# the dialog offers no extraction type at all. Set it to the configuration version the document
# pipeline really has -- read it off the Documents tab's Config version column rather than guessing,
# because a wrong name extracts against whatever version was active and reports success everywhere.
# The seed row is create-only, so changing this afterwards does nothing: edit it on the Config tab.
seed_extraction_config_version = "" # the pipeline's real configuration version, e.g. from the Documents tab's Config version column

# AWS's own public publisher account for the AWSOpenTelemetryDistroPython Lambda layer.
# NOT a secret and NOT one of our accounts — AWS publishes this ID in its public per-region
# layer ARN table, and there is no SSM parameter that resolves it. It lives in tfvars only
# because the repo's pre-push guard rejects any 12-digit run in a committed file.
# Look up the current value in AWS's docs (search "AWSOpenTelemetryDistroPython layer ARN")
# and paste the 12-digit account segment of the ARN here. Required whenever
# enable_worker_tracing = true (the default); variables.tf declares no default, so Terraform
# will stop and name this variable rather than build a bad ARN.
otel_layer_account = "<12-digit-account-id>"

# IDP MCP client-credentials, JSON: {token_url, client_id, client_secret, scope, issuer}.
# Values come from the IDP team. Empty disables the document-extraction target.
#
# ⚠️ `issuer` must be Cognito's REAL issuer — https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# — and NOT the hosted-UI domain in token_url. They are different hosts. AgentCore validates a minted
# token's `iss` claim against it, so a wrong value creates a healthy-looking provider that fails at
# token validation. Read it from the `iss` claim of a token minted against token_url:
#
#   curl -sf -X POST "$TOKEN_URL" -H 'Content-Type: application/x-www-form-urlencoded' \
#     -d "grant_type=client_credentials&client_id=$ID&client_secret=$SECRET&scope=$SCOPE" \
#     | jq -r .access_token | cut -d. -f2 | base64 -d 2>/dev/null | jq -r .iss
#
# (The deploy used to run that itself, which is why it needed curl, jq, base64 and cut on the
# machine running Terraform. It is static deployment config, so it lives here instead.)
# idp_mcp_secret_json = "{\"token_url\":\"\",\"client_id\":\"\",\"client_secret\":\"\",\"scope\":\"\",\"issuer\":\"\"}"

# Microsoft Graph gateway target ("microsoft-graph") — app-only (client_credentials).
# The recon gateway's inbound auth is Cognito JWT, so OBO (delegated, 3LO) cannot work —
# main.tf pins auth_mode = "client_credentials" for this env. Requires an Entra app
# registration granted APPLICATION permissions (Mail.Read, Mail.Send, User.Read.All,
# Sites.Read.All) with admin consent, and a current (non-expired) client secret — Entra
# app registration/consent is a manual step outside Terraform/AWS.
# graph_enabled     = true
# entra_tenant_id   = ""
# entra_client_id   = ""
# entra_client_secret = ""   # plaintext in terraform.tfvars is OK: that file is gitignored, never committed

# Okta frontend login — switches the UI from the default 'entra' provider to Okta OIDC.
# Browser PKCE redirect flow: only issuer + client id are needed (no client secret).
# okta_issuer is the auth-server base URL (e.g. https://<org>.okta.com/oauth2/default),
# NOT the .well-known metadata URL. The Okta app must be SPA/PKCE-enabled and allowlist
# https://<frontend-domain>/login/callback as a sign-in redirect URI. Changing these
# requires a frontend image rebuild (values are baked in as NEXT_PUBLIC_* build args).
# auth_provider  = "okta"
# okta_issuer    = ""
# okta_client_id = ""
# Pin the callback instead of letting the frontend derive it from the browser origin: derived, it
# changes every time the CloudFront domain does and login breaks until the new URL is registered on
# the Okta app. Must end in /login/callback. `terraform output okta_redirect_uri_to_register` prints
# the value to paste into Okta.
# okta_redirect_uri = "https://<frontend-domain>/login/callback"

# WHO MAY CHANGE CONFIGURATION — the auto-resolve threshold, the agent backend, the Tier-1 switch and
# the list of addresses the platform may email. Nothing here creates the group: this deployment has no
# Cognito user pool, so membership arrives as a claim from Okta or Entra and an operator maintains it
# there. Empty (the default) means NOBODY: every configuration route answers 403. That is a visible,
# one-variable-fixable state rather than a silently open one, so leave it empty until the group exists.
# recon_admin_group = "recon-admins"
# auth_groups_claim = "groups" # Okta: groups. Entra: groups or roles, depending on the app manifest.

# WHO MAY USE EACH APP. The console hosts two apps behind an app rail -- Trade Reconciliation and Deal
# Pipeline -- and the proxy checks the caller's group claim against the app a route belongs to. Same
# rules as recon_admin_group: an IdP group, never created here. In a RECON-ONLY deployment
# (enable_deal_pipeline = false) an access group left EMPTY keeps that app OPEN to every authenticated
# user, which is what this deployment had before the rail, so an upgrade changes nobody's access.
# With enable_deal_pipeline = true BOTH access groups are REQUIRED -- the plan refuses a blank one,
# and the console fails closed on a blank group at runtime -- because two populations then sign in
# through one OIDC client and several recon write routes are gated by the access check alone.
# Members of an app's admin group have access implicitly. The pipeline admin group fails CLOSED like
# recon_admin_group: empty means nobody can approve deals, edit skills, decide proposals or change
# the pipeline's model.
# recon_access_group    = "recon-users"
# pipeline_access_group = "deal-desk"
# pipeline_admin_group  = "deal-desk-admins"

# DEAL-PIPELINE APP. Off by default; true composes infra/modules/deal-pipeline into this root under
# the "<name_prefix>-pipeline" prefix (so it cannot collide with a standalone deal-pipeline-dev
# deployment in the same account) and wires the console to it. REQUIRES recon_access_group and
# pipeline_access_group above. The model ids mirror the standalone root's: the agent model seeds the
# pipeline's Config-tab parameter and is also what the assistant chat invokes; the memory model is
# pinned separately so a Config-tab switch cannot change how memories are extracted.
# enable_deal_pipeline     = true
# pipeline_agent_model_id  = "us.anthropic.claude-sonnet-5"
# pipeline_memory_model_id = "us.anthropic.claude-sonnet-5"

# REQUIRED. The shared mailbox every Graph message is sent FROM and read through. variables.tf
# declares no default on purpose — a mailbox address identifies a real tenant, so it belongs here
# in the gitignored file and not in committed code. Set it to "" to deploy without the email step.
graph_mailbox = "shared@<your-tenant>.onmicrosoft.com"

# SEED for the internal-notification contact, used only when the contacts table is first created.
# From then on the recipient list lives in that table and is edited from the Config tab, so editing
# this line on a running deployment does nothing — the seed carries ignore_changes precisely so an
# apply cannot undo an operator's edit (including a deactivation). Every send resolves a contact ID
# against the table at send time; no address is stored on a draft or in any Lambda's environment.
# Mail still goes out FROM graph_mailbox above via microsoft-graph sendSharedMailboxMail, so
# graph_enabled + Entra creds are still required. Empty (the default) skips the seed, and
# notifications simply do not send until an operator adds a contact. Pointing it at the shared
# mailbox itself is a reasonable single-tenant dev setup.
# notify_email = "shared@<your-tenant>.onmicrosoft.com"

# Counterparty-email recipient allowlist: the domains an analyst may address a draft to. This is the
# operator's standing answer to "who is it ever legitimate to write to", so leaving it unset allows NO
# counterparty email at all — the fail-safe direction for this control is sending nothing. The internal
# notification path above is unaffected either way.
#
# Keep the line even when the list is empty: it is enforced by the gateway interceptor
# (COUNTERPARTY_EMAIL_DOMAINS) and shown by the BFF as inline form feedback, so an explicit `[]` is the
# difference between "the operator decided" and "nobody looked". Entries must be bare lowercase domains
# — an '@', a scheme or a capital fails validation, because the interceptor matches the recipient's
# domain EXACTLY (no suffix match) and a malformed entry would read as configured while allowing
# nothing. List every subdomain you actually write to.
# counterparty_email_domains = ["<your-tenant>.onmicrosoft.com"]

# Gateway REQUEST interceptor. Two guards live here that AgentCore Policy structurally cannot
# express, because both need a DynamoDB read: PROVENANCE (the ledger row being written must be the
# one persisted on the case) and EVIDENCE QUALITY (the write is refused unless the recorded verdict
# reads CLEAN). Plus the case-transition guard.
#
# "enforce" is now the variable's DEFAULT (it used to be "log", which NEVER BLOCKS — a deployment that
# inherited that default had one gate where it used to have several, since the model's self-reported
# classification floor was deleted on 2026-09-04 and the computed evidence score plus the Cedar policy
# are the only thresholds left; security audit 2026-09-04, finding M1). It is spelled out here anyway,
# because the one thing a reader must not have to infer is whether the trust boundary blocks.
#
# The log -> enforce rollout is still the right sequence for a NEW environment: set "log" EXPLICITLY,
# deploy once, verify the e2e matrix in the interceptor's CloudWatch logs, then delete the override. It
# is a Lambda env-only change, so the flip is cheap and there is no reason to linger in "log". A local
# value is not evidence of what is live — read it off the function:
#
#   aws lambda get-function-configuration --function-name recon-dev-gw-interceptor \
#     --query 'Environment.Variables.INTERCEPTOR_MODE'
interceptor_mode = "enforce"

# Agent backend selector — 'runtime' (container AgentCore Runtime, default) or 'harness'
# (managed AgentCore Harness). Instant A/B; flip back to roll back.
# agent_backend    = "runtime"
# harness_model_id = "us.anthropic.claude-sonnet-5"   # model the managed harness invokes

# AgentCore Policy mode on the egress tools gateway. ENFORCE (default) blocks
# below-threshold autonomous writes via the Cedar confidence gate; LOG_ONLY only observes.
# policy_enforcement_mode = "ENFORCE"

# Version of AWS's public AWSOpenTelemetryDistroPython layer. Pinned, not 'latest' (AWS
# publishes no such alias), so an upstream release cannot silently change the worker.
# otel_layer_version = 30

# Max re-process attempts before a case is aged out.
# reprocess_cap = 3

# PRIVATE-VPC MODE — one flag switches the whole topology: internal ALB on private subnets,
# Fargate with no public IP, NO CloudFront, plus the interface VPC endpoints. It does NOT
# remove the NAT gateway (that stays a manual follow-up edit to infra/modules/network).
# private_ingress_cidrs is your VPN/corporate range; empty allows the VPC CIDR only.
# See the README "Private VPC deployment" section before enabling.
# private_vpc           = true
# private_ingress_cidrs = ["10.0.0.0/8"]

# Deprecated, retained for compatibility only — Graph mail now goes through the
# microsoft-graph gateway target, which owns its own Entra credentials.
# graph_secret_json = ""
