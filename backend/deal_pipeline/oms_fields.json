{
  "$comment": "Single source of truth for the OMS deal-pipeline staging CSV. Column order = array order. `type` drives formatting and validation: date=M/D/YYYY, time=h[:mm]AM|PM, percent=0.000%, mm=0.000 (millions), price=0.000, integer, boolean=Yes|No, enum, string. `source` is where the value normally comes from: email, lookup (security master), internal (firm decision; left blank by the agent), post_pricing (later wire). `required` marks the OMS minimum insert set.",
  "sections": [
    "Pipeline Deal Info",
    "Pipeline Dates",
    "Pipeline Asset Info",
    "Pipeline Spreads",
    "Ratings",
    "Pipeline Allocations"
  ],
  "fields": [
    { "key": "pipeline_status", "label": "Pipeline Status", "section": "Pipeline Deal Info", "type": "enum", "values": ["New", "Pass", "Play", "Pipeline Closed"], "source": "internal", "required": true, "default": "New", "notes": "Agent always stages as New; the desk moves it." },
    { "key": "pipeline_type", "label": "Pipeline Type", "section": "Pipeline Deal Info", "type": "enum", "values": ["Loan", "Bond"], "source": "email", "required": true, "notes": "Term loans, revolvers, incremental/add-on facilities are Loan; notes and bonds are Bond." },
    { "key": "opportunity_name", "label": "Opportunity Name", "section": "Pipeline Deal Info", "type": "string", "source": "email", "required": true, "max_length": 60, "notes": "Issuer short name + deal type, e.g. 'Northwind add-on TLB'. No currency symbols or amounts." },
    { "key": "region", "label": "Region", "section": "Pipeline Deal Info", "type": "enum", "values": ["North America", "Europe", "Asia Pacific", "Latin America", "Global"], "source": "lookup", "required": false },
    { "key": "sponsors", "label": "Sponsors", "section": "Pipeline Deal Info", "type": "string", "source": "lookup", "required": false, "notes": "'Public' for listed companies; otherwise sponsor names separated by ' / '." },
    { "key": "left_agent", "label": "Left Agent", "section": "Pipeline Deal Info", "type": "string", "source": "email", "required": false, "notes": "Lead-left arranger / bookrunner, OMS canonical counterparty name." },
    { "key": "right_agent", "label": "Right Agent", "section": "Pipeline Deal Info", "type": "string", "source": "email", "required": false },
    { "key": "priority", "label": "Priority", "section": "Pipeline Deal Info", "type": "boolean", "source": "internal", "required": false },
    { "key": "play", "label": "Play?", "section": "Pipeline Deal Info", "type": "enum", "values": ["Yes", "No"], "source": "internal", "required": false },
    { "key": "trader", "label": "Trader", "section": "Pipeline Deal Info", "type": "string", "source": "internal", "required": false },
    { "key": "vp_at_issue", "label": "VP at Issue", "section": "Pipeline Deal Info", "type": "string", "source": "internal", "required": false },
    { "key": "industry", "label": "Industry", "section": "Pipeline Deal Info", "type": "string", "source": "lookup", "required": false },
    { "key": "own_issuer", "label": "Own Issuer?", "section": "Pipeline Deal Info", "type": "boolean", "source": "internal", "required": false },
    { "key": "relevant_leverage", "label": "Relevant Leverage", "section": "Pipeline Deal Info", "type": "string", "source": "internal", "required": false },
    { "key": "relevant_ltv", "label": "Relevant LTV", "section": "Pipeline Deal Info", "type": "string", "source": "internal", "required": false },
    { "key": "priced", "label": "Priced?", "section": "Pipeline Deal Info", "type": "boolean", "source": "email", "required": false, "notes": "Yes only when final pricing is stated." },
    { "key": "played", "label": "Played?", "section": "Pipeline Deal Info", "type": "boolean", "source": "internal", "required": false },

    { "key": "date_arrived", "label": "Date Arrived", "section": "Pipeline Dates", "type": "date", "source": "email", "required": true, "notes": "Email received date." },
    { "key": "launch_date", "label": "Launch Date", "section": "Pipeline Dates", "type": "date", "source": "email", "required": false },
    { "key": "commit_due", "label": "Commit Due", "section": "Pipeline Dates", "type": "date", "source": "email", "required": false },
    { "key": "commit_due_time", "label": "Commit Due Time", "section": "Pipeline Dates", "type": "time", "source": "email", "required": false, "notes": "Desk-local time, e.g. 12PM or 5:00PM." },
    { "key": "date_recommendation_received", "label": "Date Recommendation Received", "section": "Pipeline Dates", "type": "date", "source": "internal", "required": false },
    { "key": "commit_date", "label": "Commit Date", "section": "Pipeline Dates", "type": "date", "source": "internal", "required": false },
    { "key": "funding_date", "label": "Funding Date", "section": "Pipeline Dates", "type": "date", "source": "internal", "required": false },

    { "key": "asset", "label": "Asset", "section": "Pipeline Asset Info", "type": "string", "source": "lookup", "required": false, "notes": "Security master asset id; usually unknown for new issues." },
    { "key": "maturity_date", "label": "Maturity Date", "section": "Pipeline Asset Info", "type": "date", "source": "email", "required": false },
    { "key": "maturity_terms", "label": "Maturity Terms", "section": "Pipeline Asset Info", "type": "string", "source": "email", "required": true, "pattern": "^\\d+(\\.\\d+)? yr$", "notes": "Tenor as 'N yr' (e.g. '7 yr', '4.5 yr'). Preferred over Maturity Date." },
    { "key": "currency", "label": "Currency", "section": "Pipeline Asset Info", "type": "enum", "values": ["USD", "EUR", "GBP", "CAD"], "source": "email", "required": true },
    { "key": "issue_size_mm", "label": "Issue Size (MM)", "section": "Pipeline Asset Info", "type": "mm", "source": "email", "required": true },
    { "key": "new_money_mm", "label": "New Money (MM)", "section": "Pipeline Asset Info", "type": "mm", "source": "email", "required": false },
    { "key": "call_protection", "label": "Call Protection", "section": "Pipeline Asset Info", "type": "string", "source": "email", "required": false },
    { "key": "is_secured", "label": "Is Secured?", "section": "Pipeline Asset Info", "type": "boolean", "source": "email", "required": false },
    { "key": "secured_level", "label": "Secured Level", "section": "Pipeline Asset Info", "type": "enum", "values": ["Senior Secured", "First Lien", "Second Lien", "Senior Unsecured", "Subordinated"], "source": "email", "required": false },
    { "key": "security_type", "label": "Security Type", "section": "Pipeline Asset Info", "type": "enum", "values": ["Loan", "Bond"], "source": "email", "required": true },
    { "key": "uop", "label": "UOP", "section": "Pipeline Asset Info", "type": "enum", "values": ["Refinance", "Amend & Extend", "Acquisition", "LBO", "Dividend Recap", "General Corporate Purposes", "Project Finance", "Other"], "source": "email", "required": false },
    { "key": "notes", "label": "Notes", "section": "Pipeline Asset Info", "type": "string", "source": "email", "required": false, "max_length": 200 },
    { "key": "early_look", "label": "Early Look", "section": "Pipeline Asset Info", "type": "string", "source": "internal", "required": false },
    { "key": "covenant_status_num", "label": "Covenant Status #", "section": "Pipeline Asset Info", "type": "integer", "min": 1, "max": 4, "source": "email", "required": false, "notes": "1 = maintenance covenants, 2 = incurrence only, 3 = cov-lite, 4 = unknown / TBD." },
    { "key": "bps_taken_out", "label": "BPS Taken Out", "section": "Pipeline Asset Info", "type": "integer", "source": "email", "required": false },
    { "key": "is_revolver", "label": "Is Revolver?", "section": "Pipeline Asset Info", "type": "boolean", "source": "email", "required": false },

    { "key": "fixed_floating", "label": "Fixed/Floating", "section": "Pipeline Spreads", "type": "enum", "values": ["Fixed", "Floating"], "source": "email", "required": true },
    { "key": "initial_spread_talk_low", "label": "Initial Coupon/Spread Talk Low", "section": "Pipeline Spreads", "type": "percent", "source": "email", "required": false, "notes": "S+200 = 2.000%; bps to percent." },
    { "key": "initial_spread_talk_high", "label": "Initial Coupon/Spread Talk High", "section": "Pipeline Spreads", "type": "percent", "source": "email", "required": false },
    { "key": "initial_price_talk_low", "label": "Initial Issue Price Talk Low", "section": "Pipeline Spreads", "type": "price", "source": "email", "required": false, "notes": "OID low end, e.g. 99.500." },
    { "key": "initial_price_talk_high", "label": "Initial Issue Price Talk High", "section": "Pipeline Spreads", "type": "price", "source": "email", "required": false },
    { "key": "floor_talk", "label": "Floor Talk", "section": "Pipeline Spreads", "type": "percent", "source": "email", "required": false },
    { "key": "spread_talk_low", "label": "Coupon/Spread Talk Low", "section": "Pipeline Spreads", "type": "percent", "source": "email", "required": false },
    { "key": "spread_talk_high", "label": "Coupon/Spread Talk High", "section": "Pipeline Spreads", "type": "percent", "source": "email", "required": false },
    { "key": "price_talk_low", "label": "Issue Price Talk Low", "section": "Pipeline Spreads", "type": "price", "source": "post_pricing", "required": false },
    { "key": "price_talk_high", "label": "Issue Price Talk High", "section": "Pipeline Spreads", "type": "price", "source": "post_pricing", "required": false },
    { "key": "final_floor", "label": "Final Floor", "section": "Pipeline Spreads", "type": "percent", "source": "email", "required": false },
    { "key": "final_spread", "label": "Final Coupon/Spread", "section": "Pipeline Spreads", "type": "percent", "source": "post_pricing", "required": false },
    { "key": "final_yield", "label": "Final Yield", "section": "Pipeline Spreads", "type": "percent", "source": "email", "required": false },
    { "key": "issue_price_final", "label": "Issue Price Final", "section": "Pipeline Spreads", "type": "price", "source": "post_pricing", "required": false },
    { "key": "desk_notes", "label": "Desk Notes", "section": "Pipeline Spreads", "type": "string", "source": "internal", "required": false },

    { "key": "sp_issue_rating", "label": "S&P Issue Rating", "section": "Ratings", "type": "string", "source": "email", "required": false },
    { "key": "moodys_issue_rating", "label": "Moody's Issue Rating", "section": "Ratings", "type": "string", "source": "email", "required": false },
    { "key": "fitch_issue_rating", "label": "Fitch Issue Rating", "section": "Ratings", "type": "string", "source": "email", "required": false },
    { "key": "sp_corp_rating", "label": "S&P Corp Rating", "section": "Ratings", "type": "string", "source": "email", "required": false },
    { "key": "moodys_corp_rating", "label": "Moody's Corp Rating", "section": "Ratings", "type": "string", "source": "email", "required": false },
    { "key": "fitch_corp_rating", "label": "Fitch Corp Rating", "section": "Ratings", "type": "string", "source": "email", "required": false },
    { "key": "sp_recovery_rating", "label": "S&P Recovery Rating", "section": "Ratings", "type": "string", "source": "email", "required": false },
    { "key": "liquidity_score", "label": "Liquidity Score", "section": "Ratings", "type": "string", "source": "lookup", "required": false },
    { "key": "is_investment_grade", "label": "Is Investment Grade?", "section": "Ratings", "type": "boolean", "source": "email", "required": false, "notes": "Yes when the issue rating is BBB-/Baa3 or better." },

    { "key": "primary_trade", "label": "Primary Trade", "section": "Pipeline Allocations", "type": "string", "source": "internal", "required": false },
    { "key": "commit_amount_mm", "label": "Commit Amount (MM)", "section": "Pipeline Allocations", "type": "mm", "source": "internal", "required": false },
    { "key": "pct_commit", "label": "% Commit", "section": "Pipeline Allocations", "type": "percent", "source": "internal", "required": false, "default": "0.000%" },
    { "key": "fund_order_mm", "label": "Fund Order (MM)", "section": "Pipeline Allocations", "type": "mm", "source": "internal", "required": false },
    { "key": "pct_fill_fund_order", "label": "% Fill Fund Order", "section": "Pipeline Allocations", "type": "percent", "source": "internal", "required": false },
    { "key": "allocation_amount_mm", "label": "Allocation Amount (MM)", "section": "Pipeline Allocations", "type": "mm", "source": "internal", "required": false },
    { "key": "pct_fill_market_order", "label": "% Fill Market Order", "section": "Pipeline Allocations", "type": "percent", "source": "internal", "required": false },
    { "key": "trade_date", "label": "Trade Date", "section": "Pipeline Allocations", "type": "date", "source": "internal", "required": false },
    { "key": "counterparty", "label": "Counterparty", "section": "Pipeline Allocations", "type": "string", "source": "internal", "required": false },
    { "key": "allocation_comments", "label": "Allocation Comments", "section": "Pipeline Allocations", "type": "string", "source": "internal", "required": false }
  ]
}
